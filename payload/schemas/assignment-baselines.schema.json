{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:unknown-knowledge:schema:assignment-baselines",
  "title": "Captured assignment adoption baselines",
  "description": "Assignment adoption or tagged creation baselines. The shared chain checks exact genesis event/ref/state/content-capture binding. Actual source membership, identity freshness, current-state and publication checks remain separate.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema-version",
    "namespace",
    "baselines"
  ],
  "properties": {
    "schema-version": {
      "type": "integer",
      "enum": [
        1
      ]
    },
    "namespace": {
      "$ref": "#/$defs/assignmentNamespace"
    },
    "baselines": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "ref",
          "state",
          "capture"
        ],
        "properties": {
          "ref": {
            "$ref": "#/$defs/assignmentOwnerRef"
          },
          "state": {
            "$ref": "#/$defs/assignmentState"
          },
          "capture": {
            "$ref": "#/$defs/assignmentCapture"
          },
          "origin": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "kind",
              "event"
            ],
            "properties": {
              "kind": {
                "enum": [
                  "creation"
                ]
              },
              "event": {
                "$ref": "#/$defs/assignmentNamespace"
              }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "assignmentNamespace": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}(?![\\s\\S])$"
    },
    "assignmentSubjectId": {
      "type": "string",
      "pattern": "^S-(?!000000)[0-9]{6}(?![\\s\\S])$"
    },
    "assignmentOwnerRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "namespace",
        "kind",
        "id"
      ],
      "properties": {
        "namespace": {
          "$ref": "#/$defs/assignmentNamespace"
        },
        "kind": {
          "enum": [
            "knowledge",
            "ontology",
            "decision"
          ]
        },
        "id": {
          "type": "string",
          "pattern": "(?:^K-(?!000000)[0-9]{6}(?![\\s\\S])$)|(?:^O-(?!000000)[0-9]{6}(?![\\s\\S])$)|(?:^D-(?!000000)[0-9]{6}(?![\\s\\S])$)"
        }
      }
    },
    "assignmentState": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state"
      ],
      "properties": {
        "state": {
          "enum": [
            "known",
            "unknown"
          ]
        },
        "ids": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/assignmentSubjectId"
          }
        },
        "reason": {
          "enum": [
            "absent"
          ]
        }
      },
      "description": "Conditional known/unknown shape and duplicate IDs are enforced by the shared assignment state reader."
    },
    "assignmentCapture": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "file",
        "blob",
        "sha256"
      ],
      "properties": {
        "file": {
          "type": "string",
          "pattern": "\\S"
        },
        "blob": {
          "type": "string",
          "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})(?![\\s\\S])$"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}(?![\\s\\S])$"
        },
        "source": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "commit",
            "tree"
          ],
          "properties": {
            "commit": {
              "type": "string",
              "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})(?![\\s\\S])$"
            },
            "tree": {
              "type": "string",
              "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})(?![\\s\\S])$"
            }
          }
        }
      },
      "description": "The shared capture locator validator additionally enforces normalized relative paths and matching Git object formats. Shape alone does not verify bytes or membership."
    }
  }
}
