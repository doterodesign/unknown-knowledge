{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:unknown-knowledge:schema:assignment-creation-event",
  "title": "Canonical creation assignment event",
  "description": "Version 2 genesis metadata. Null denotes no prior canonical record. Actual identity freshness, captured membership, effective eligibility and publication approval remain separate mandatory gates.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema-version",
    "event",
    "namespace",
    "operation",
    "scope",
    "before-input",
    "candidate-records-digest",
    "decision",
    "review",
    "rows"
  ],
  "properties": {
    "schema-version": {
      "type": "integer",
      "enum": [
        2
      ]
    },
    "namespace": {
      "$ref": "#/$defs/assignmentNamespace"
    },
    "event": {
      "$ref": "#/$defs/assignmentNamespace"
    },
    "rows": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "ref",
          "before",
          "after",
          "before-revision",
          "after-revision",
          "disposition",
          "reason",
          "before-capture",
          "after-capture"
        ],
        "properties": {
          "ref": {
            "$ref": "#/$defs/assignmentOwnerRef"
          },
          "before": {
            "type": "null"
          },
          "after": {
            "$ref": "#/$defs/assignmentState"
          },
          "before-revision": {
            "type": "null"
          },
          "after-revision": {
            "type": "integer",
            "enum": [
              0
            ]
          },
          "disposition": {
            "enum": [
              "created"
            ]
          },
          "reason": {
            "type": "string",
            "pattern": "\\S"
          },
          "before-capture": {
            "type": "null"
          },
          "after-capture": {
            "$ref": "#/$defs/assignmentCandidateCapture"
          }
        }
      }
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "refs"
      ],
      "properties": {
        "kind": {
          "enum": [
            "typed-records"
          ]
        },
        "refs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/assignmentOwnerRef"
          }
        }
      }
    },
    "before-input": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "commit",
        "tree",
        "kit-path"
      ],
      "properties": {
        "commit": {
          "type": "string",
          "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})(?![\\s\\S])$"
        },
        "tree": {
          "type": "string",
          "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})(?![\\s\\S])$"
        },
        "kit-path": {
          "type": "string",
          "pattern": "\\S"
        }
      }
    },
    "candidate-records-digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}(?![\\s\\S])$"
    },
    "decision": {
      "$ref": "#/$defs/assignmentOwnerRef"
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reference",
        "accepted-status",
        "decision-capture",
        "decision-digest",
        "change-digest"
      ],
      "properties": {
        "reference": {
          "type": "string",
          "pattern": "\\S"
        },
        "accepted-status": {
          "enum": [
            "accepted",
            "addressed"
          ]
        },
        "decision-capture": {
          "$ref": "#/$defs/assignmentCapture"
        },
        "decision-digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}(?![\\s\\S])$"
        },
        "change-digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}(?![\\s\\S])$"
        }
      }
    },
    "operation": {
      "enum": [
        "canonical-creation"
      ]
    }
  },
  "$defs": {
    "assignmentNamespace": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}(?![\\s\\S])$"
    },
    "assignmentSubjectId": {
      "type": "string",
      "pattern": "^S-(?!000000)[0-9]{6}(?![\\s\\S])$"
    },
    "assignmentOwnerRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "namespace",
        "kind",
        "id"
      ],
      "properties": {
        "namespace": {
          "$ref": "#/$defs/assignmentNamespace"
        },
        "kind": {
          "enum": [
            "knowledge",
            "ontology",
            "decision"
          ]
        },
        "id": {
          "type": "string",
          "pattern": "(?:^K-(?!000000)[0-9]{6}(?![\\s\\S])$)|(?:^O-(?!000000)[0-9]{6}(?![\\s\\S])$)|(?:^D-(?!000000)[0-9]{6}(?![\\s\\S])$)"
        }
      }
    },
    "assignmentState": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state"
      ],
      "properties": {
        "state": {
          "enum": [
            "known",
            "unknown"
          ]
        },
        "ids": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/assignmentSubjectId"
          }
        },
        "reason": {
          "enum": [
            "absent"
          ]
        }
      },
      "description": "Conditional known/unknown shape and duplicate IDs are enforced by the shared assignment state reader."
    },
    "assignmentCapture": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "file",
        "blob",
        "sha256"
      ],
      "properties": {
        "file": {
          "type": "string",
          "pattern": "\\S"
        },
        "blob": {
          "type": "string",
          "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})(?![\\s\\S])$"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}(?![\\s\\S])$"
        },
        "source": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "commit",
            "tree"
          ],
          "properties": {
            "commit": {
              "type": "string",
              "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})(?![\\s\\S])$"
            },
            "tree": {
              "type": "string",
              "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})(?![\\s\\S])$"
            }
          }
        }
      },
      "description": "The shared capture locator validator additionally enforces normalized relative paths and matching Git object formats. Shape alone does not verify bytes or membership."
    },
    "assignmentCommittedCapture": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "file",
        "blob",
        "sha256",
        "source"
      ],
      "properties": {
        "file": {
          "type": "string",
          "pattern": "\\S"
        },
        "blob": {
          "type": "string",
          "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})(?![\\s\\S])$"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}(?![\\s\\S])$"
        },
        "source": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "commit",
            "tree"
          ],
          "properties": {
            "commit": {
              "type": "string",
              "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})(?![\\s\\S])$"
            },
            "tree": {
              "type": "string",
              "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})(?![\\s\\S])$"
            }
          }
        }
      },
      "description": "The shared capture locator validator additionally enforces normalized relative paths and matching Git object formats. Shape alone does not verify bytes or membership."
    },
    "assignmentCandidateCapture": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "file",
        "blob",
        "sha256"
      ],
      "properties": {
        "file": {
          "type": "string",
          "pattern": "\\S"
        },
        "blob": {
          "type": "string",
          "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})(?![\\s\\S])$"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}(?![\\s\\S])$"
        }
      }
    }
  }
}
